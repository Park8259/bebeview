<?xml version="1.0" encoding="utf-8"?>
<!--
  베베뷰 서버(EC2, HTTP)와 통신하기 위한 설정.
  안드로이드는 기본적으로 평문(HTTP) 통신을 막는데, 이 IP로만 예외를 허용함.
  (도메인+HTTPS로 옮기면 이 파일과 매니페스트의 networkSecurityConfig 줄을 지워도 됨)
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">43.201.67.12</domain>
    </domain-config>
</network-security-config>
